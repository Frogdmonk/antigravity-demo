# ==============================================================================
# GEMINI CHAT – AI ASSISTANT: ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Exposed to the browser via Vite)
# ------------------------------------------------------------------------------
# Your Supabase Project URL (e.g., https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Public Anonymous Key (safe for client-side queries protected by RLS)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------------------------------------------
# BACKEND / SERVERLESS CONFIGURATION (Vercel Serverless Functions / Local Dev API)
# NEVER expose these with a VITE_ prefix. They are exclusively read by server functions.
# ------------------------------------------------------------------------------
# Supabase project URL for server functions
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon key used to verify user JWT tokens on server
SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Supabase Service Role Key (used only if administrative tasks require elevated privileges)
# Leave blank or set only in secure server settings. Never expose to client!
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your-gemini-api-key

# Gemini Model identifier (Defaults to gemini-3.5-flash with automatic fallback to gemini-3.8-flash)
GEMINI_MODEL=gemini-3.5-flash
